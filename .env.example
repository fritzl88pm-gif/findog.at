# Supabase Auth in the browser. These values are safe to expose because they use
# the public anon key, not the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase Auth validation and chat persistence. Never expose the
# service role key to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only DeepSeek key for BFG Suche PRO. Do not expose this to browser
# code. GLOBAL_DEEPSEEK_API_KEY is an optional fallback.
DEEPSEEK_API_KEY=
# GLOBAL_DEEPSEEK_API_KEY=

# Fred via the native Findog chat UI and WeKnora's secure embed API. All values
# stay server-side; the browser receives neither token nor session signature.
# The publish token must start with em_ and is not the account API key (sk-...).
# Configure the same exchange origin in the channel's allowed_origins list.
WEKNORA_FRED_CHANNEL_ID=
WEKNORA_FRED_PUBLISH_TOKEN=
WEKNORA_FRED_EXCHANGE_ORIGIN=https://findog.at
# Shared HMAC secret configured for Fred's WeKnora message_sent/message_received
# webhook. Use at least 32 random characters and keep it server-side.
WEKNORA_FRED_WEBHOOK_SECRET=

# Server-only exact active deepseek-v4-pro KnowledgeQA model ID (canonical UUID).
# When set, Fred Pro Mode is available. This is a non-secret server-side model
# identifier, not an API key. The browser never receives this value.
WEKNORA_FRED_PRO_MODEL_ID=

# Optional QuickFred secure embed channel. QuickFred must be bound to its own
# channel and expose the same web-search capability as Fred. The expected agent
# ID fails closed if the channel is rebound. All values remain server-side.
WEKNORA_QUICKFRED_CHANNEL_ID=
WEKNORA_QUICKFRED_PUBLISH_TOKEN=
WEKNORA_QUICKFRED_EXCHANGE_ORIGIN=https://findog.at
WEKNORA_QUICKFRED_AGENT_ID=

# Per-user Telegram bots. Generate TELEGRAM_CREDENTIALS_KEY as 32 random bytes
# in canonical standard Base64: openssl rand -base64 32
# It encrypts bot tokens with AES-256-GCM and must stay identical in both services.
TELEGRAM_CREDENTIALS_KEY=
TELEGRAM_PUBLIC_ORIGIN=https://findog.at
TELEGRAM_WORKER_CONCURRENCY=2
TELEGRAM_WORKER_PORT=3001

# Server-only OmniRoute management API access. The browser never receives
# these values or upstream account/connection details.
OMNIROUTE_ADMIN_BASE_URL=
OMNIROUTE_ADMIN_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# Server-only bearer token for the read-only WeKnora knowledge dashboard MCP.
# The endpoint override is optional and should remain HTTPS outside tests.
WEKNORA_READONLY_MCP_BEARER_TOKEN=
# WEKNORA_READONLY_MCP_URL=https://taxdog.cloud/mcp/bfg-query

# Server-only OpenRouter key for Scanning and image-assisted form extraction.
# The browser never receives this key.
OPENROUTER_API_KEY=

# Process-wide admission cap shared by Scanning and Fred attachment requests.
# Keep this at 1 unless the container has a measured memory budget for more.
FINDOG_HEAVY_ATTACHMENT_CONCURRENCY=1

# Server-only MinerU API token for attachment preprocessing.
# The browser never receives this key.
MINERU_API_TOKEN=
